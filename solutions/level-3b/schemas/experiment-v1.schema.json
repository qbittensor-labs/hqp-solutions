{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/experiment-v1.schema.json",
  "title": "Peaked-circuit experiment record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "id",
    "instance",
    "provenance",
    "protocol",
    "execution",
    "trials",
    "artifacts",
    "observations",
    "outcome"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "experiment"},
    "id": {"type": "string", "pattern": "^exp\\.[a-z0-9._-]+$"},
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "qasm_sha256", "target_access"],
      "properties": {
        "id": {"enum": ["s1", "s2", "p9-control"]},
        "qasm_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "target_access": {"enum": ["blind", "diagnostic_probe", "control"]}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_repository", "source_ref", "code_commit", "quality"],
      "properties": {
        "source_repository": {"type": "string", "format": "uri"},
        "source_ref": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "code_commit": {
          "oneOf": [
            {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            {"type": "null"}
          ]
        },
        "quality": {"enum": ["complete", "partial", "unknown"]},
        "notes": {"type": "string"}
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "config"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "config": {"type": "object"},
        "preregistered_plan": {"type": ["string", "null"]}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal_state"],
      "properties": {
        "started_at": {"type": "string", "format": "date-time"},
        "wall_seconds": {"type": "number", "minimum": 0},
        "exit_code": {"type": ["integer", "null"]},
        "terminal_state": {
          "enum": ["completed", "oom", "timeout", "killed", "skipped", "partial", "crashed"]
        }
      }
    },
    "trials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trial_id", "terminal_state"],
        "properties": {
          "trial_id": {"type": "string", "minLength": 1},
          "seed": {"type": ["integer", "null"]},
          "terminal_state": {
            "enum": ["completed", "oom", "timeout", "killed", "skipped", "partial", "crashed"]
          },
          "depth_reached": {"type": ["integer", "null"], "minimum": 0},
          "depth_total": {"type": ["integer", "null"], "minimum": 0}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {"type": "string", "pattern": "^artifact\\."},
      "uniqueItems": true
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "semantic_name",
          "value",
          "qualifier",
          "target_dependent",
          "artifact_ref"
        ],
        "properties": {
          "semantic_name": {"type": "string", "minLength": 1},
          "value": {"type": ["number", "integer", "string", "boolean", "null"]},
          "unit": {"type": ["string", "null"]},
          "qualifier": {
            "enum": ["exact", "approximate", "lower_bound", "upper_bound", "censored"]
          },
          "censoring": {"enum": ["none", "left", "right", "interval"]},
          "lower_bound": {"type": "number"},
          "upper_bound": {"type": "number"},
          "target_dependent": {"type": "boolean"},
          "trial_id": {"type": ["string", "null"]},
          "artifact_ref": {"type": "string", "pattern": "^artifact\\."},
          "line_start": {"type": "integer", "minimum": 1},
          "line_end": {"type": "integer", "minimum": 1},
          "notes": {"type": "string"}
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verification_status", "reported_solver_status", "verification_method"],
      "properties": {
        "verification_status": {
          "enum": ["verified_success", "verified_failure", "inconclusive", "not_applicable"]
        },
        "reported_solver_status": {
          "enum": ["success", "failed", "timeout", "none", "not_applicable"]
        },
        "verification_method": {"type": "string", "minLength": 1},
        "notes": {"type": "string"}
      }
    }
  }
}
