{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/claim-v1.schema.json",
  "title": "Audited claim or correction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "id",
    "statement",
    "status",
    "scope",
    "supporting_evidence",
    "contrary_evidence",
    "rationale"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "claim"},
    "id": {"type": "string", "pattern": "^claim\\.[a-z0-9._-]+$"},
    "statement": {"type": "string", "minLength": 1},
    "status": {
      "enum": ["supported", "partially_supported", "unsupported", "contradicted", "superseded"]
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "supporting_evidence": {
      "type": "array",
      "items": {"type": "string", "pattern": "^(exp|artifact)\\."},
      "uniqueItems": true
    },
    "contrary_evidence": {
      "type": "array",
      "items": {"type": "string", "pattern": "^(exp|artifact)\\."},
      "uniqueItems": true
    },
    "rationale": {"type": "string", "minLength": 1},
    "supersedes": {"type": ["string", "null"], "pattern": "^claim\\."}
  }
}
